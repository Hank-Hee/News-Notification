# Environment Variables

# Kimi Platform (required for the personal daily configuration)
MOONSHOT_API_KEY=replace_with_your_kimi_platform_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Copy the exact model ID shown in your Kimi Platform console; do not guess it.
KIMI_MODEL_ID=replace_with_your_model_id

# Other Horizon providers (optional; unused by data/config.github.json)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
GOOGLE_API_KEY=xxx
MINIMAX_API_KEY=xxx
DASHSCOPE_API_KEY=xxx
DOUBAO_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# WebHook Url (optional for sending notifications)
HORIZON_WEBHOOK_URL=https://xxx

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=ghp_xxx

# Apify Token (required for Twitter scraping)
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx
