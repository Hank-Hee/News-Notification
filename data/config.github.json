  "filtering": {
    "rule_prefilter_enabled": true,
    "time_window_hours": 24,
    "ai_score_threshold": 7.0,
    "candidate_limit": 40,
    "per_source_limit": 8,
    "source_priority": ["public_web", "newsletter", "rss", "github", "hackernews", "google_news", "reddit", "gdelt"],
    "source_time_window_hours": {"newsletter": 168, "public_web": 336},
    "min_content_chars": 40,
    "community_min_score": 5,
    "final_min_items": 8,
    "final_max_items": 12,
    "deep_analysis_limit": 2,
    "history_dedup_days": 7,
    "max_items": 12,
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "balance": {
    "enabled": false,
    "tech_target_ratio": 0.5,
    "product_target_ratio": 0.5,
    "china_target_ratio": 0.5,
    "global_target_ratio": 0.5,
    "strict": false
  },
  "product_intelligence": {
    "enabled": true,
    "json_path": "data/product-intelligence.json",
    "csv_path": "data/product-intelligence.csv",
    "publish_directory": "docs/data",
    "max_records": 2000,
    "max_updates_per_product": 20
  },
  "cost_control": {
    "max_ai_requests_per_run": 12,
    "max_daily_cost_cny": 2.0,
    "max_retries_per_stage": 1,
    "analysis_cache_enabled": true,
    "analysis_cache_path": "data/history/analysis_cache.json",
    "analysis_cache_max_records": 5000
  },
  "email": null,
  "webhook": {"enabled": false}
