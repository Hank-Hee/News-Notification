{
  "version": "1.1",
  "ai": {
    "candidate_analysis": {
      "provider": "deepseek",
      "model": "${DEEPSEEK_CANDIDATE_MODEL}",
      "base_url": "${DEEPSEEK_BASE_URL}",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "max_completion_tokens": 4096,
      "thinking": {"type": "disabled"},
      "throttle_sec": 0.2,
      "languages": ["zh"],
      "analysis_concurrency": 1,
      "analysis_batch_size": 10,
      "input_cost_per_million_cny": 1.0,
      "output_cost_per_million_cny": 2.0
    },
    "semantic_dedup": {
      "provider": "deepseek",
      "model": "${DEEPSEEK_CANDIDATE_MODEL}",
      "base_url": "${DEEPSEEK_BASE_URL}",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.0,
      "max_completion_tokens": 2048,
      "thinking": {"type": "disabled"},
      "throttle_sec": 0.2,
      "languages": ["zh"],
      "analysis_concurrency": 1,
      "analysis_batch_size": 10,
      "input_cost_per_million_cny": 1.0,
      "output_cost_per_million_cny": 2.0
    },
    "deep_analysis": {
      "provider": "openai",
      "model": "${KIMI_MODEL_ID}",
      "base_url": "${KIMI_BASE_URL}",
      "api_key_env": "MOONSHOT_API_KEY",
      "temperature": 0.6,
      "max_completion_tokens": 4096,
      "thinking": {"type": "disabled"},
      "languages": ["zh"],
      "enrichment_concurrency": 1,
      "input_cost_per_million_cny": 6.5,
      "output_cost_per_million_cny": 27.0
    },
    "deep_analysis_fallback": {
      "provider": "deepseek",
      "model": "${DEEPSEEK_FALLBACK_MODEL}",
      "base_url": "${DEEPSEEK_BASE_URL}",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "max_completion_tokens": 4096,
      "thinking": {"type": "disabled"},
      "languages": ["zh"],
      "enrichment_concurrency": 1,
      "input_cost_per_million_cny": 3.0,
      "output_cost_per_million_cny": 6.0
    }
  },
